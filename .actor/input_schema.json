{
  "title": "Privacy Stack - Ultimate Privacy Project Scraper",
  "description": "Scrape privacy projects, papers, implementations across GitHub and arXiv",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "sources": {
      "sectionCaption": "Data Sources",
      "title": "Sources to Scrape",
      "type": "array",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": ["github", "arxiv"]
      },
      "default": ["github", "arxiv"],
      "description": "Select which platforms to scrape for privacy projects"
    },
    "keywords": {
      "title": "Privacy Keywords",
      "type": "array",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": ["mixnet", "zk-proof", "tor", "nym", "monero", "zcash", "signal", "coinjoin", "mpc", "fhe"]
      },
      "default": ["mixnet", "zk-proof"],
      "description": "Select privacy keywords to search"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "default": 100,
      "minimum": 10,
      "maximum": 500,
      "description": "Maximum projects to return"
    }
  },
  "required": ["keywords"]
}
