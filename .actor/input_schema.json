{
  "title": "Privacy Stack - Ultimate Privacy Project Scraper",
  "description": "Scrape privacy projects, papers, implementations across GitHub, arXiv, Reddit, Twitter, HackerNews.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "sources": {
      "sectionCaption": "Data Sources",
      "title": "Sources to Scrape",
      "type": "array",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": ["github", "arxiv", "reddit", "hackernews", "twitter"]
      },
      "default": ["github", "arxiv"]
    },
    "keywords": {
      "title": "Privacy Keywords",
      "type": "array",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": ["mixnet", "zk-proof", "tor", "nym", "monero", "zcash", "signal", "coinjoin", "mpc", "fhe"]
      },
      "default": ["mixnet", "zk-proof", "tor"],
      "description": "Select privacy keywords to search"
    },
    "starsMin": {
      "title": "Minimum GitHub Stars",
      "type": "integer",
      "default": 50,
      "minimum": 0
    },
    "updatedDays": {
      "title": "Updated in Last N Days",
      "type": "integer",
      "default": 90,
      "minimum": 1
    },
    "language": {
      "title": "Programming Language",
      "type": "string",
      "editor": "select",
      "enum": ["Python", "Rust", "Go", "JavaScript", "Haskell", "C++", "All"],
      "default": "All"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "default": 100,
      "minimum": 10,
      "maximum": 500
    },
    "includeMetadata": {
      "title": "Include Metadata",
      "type": "boolean",
      "default": true
    }
  },
  "required": ["keywords"]
}
