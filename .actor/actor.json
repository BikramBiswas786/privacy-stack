{
  "name": "privacy-stack-research-scraper",
  "title": "Privacy & Anonymity Research Papers Scraper",
  "description": "Scrapes and aggregates 50+ research papers on privacy and anonymity with production Python implementations",
  "version": "1.0.0",
  "type": "nodejs",
  "entrypoint": "./src/main.js",
  "actorSpecification": 2,
  "input": "./actor/input_schema.json",
  "output": "./actor/output_schema.json",
  "metadata": {
    "categories": ["scrapers", "research", "privacy"],
    "documentationUrl": "https://github.com/BikramBiswas786/privacy-stack",
    "sourceUrl": "https://github.com/BikramBiswas786/privacy-stack"
  },
  "build": {
    "base": "node:20-alpine"
  },
  "storages": {
    "dataset": {
      "maxItems": 1000
    }
  },
  "env": {
    "APIFY_MAX_PAYLOAD_SIZE_BYTES": "52428800"
  }
}
